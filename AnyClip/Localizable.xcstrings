{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@) failed: %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@) gagal: %@"
          }
        }
      }
    },
    "%@ (Recommended)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Disarankan)"
          }
        }
      }
    },
    "%@ / %@" : {},
    "%@ API Key" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API %@"
          }
        }
      }
    },
    "%@ The video was transcribed with Apple speech recognition instead." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Video ditranskripsi dengan pengenalan suara Apple sebagai gantinya."
          }
        }
      }
    },
    "%@ didn’t match its published checksum, so it wasn’t installed. Try again later." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak cocok dengan checksum yang dipublikasikan, jadi tidak diinstal. Coba lagi nanti."
          }
        }
      }
    },
    "%@ didn’t respond: %@ Apple Intelligence was used instead." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak merespons: %@ Apple Intelligence dipakai sebagai gantinya."
          }
        }
      }
    },
    "%@ failed — switching to Apple Intelligence…" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gagal — beralih ke Apple Intelligence…"
          }
        }
      }
    },
    "%@ has no API key, so Apple Intelligence was used instead." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ belum punya kunci API, jadi Apple Intelligence dipakai sebagai gantinya."
          }
        }
      }
    },
    "%@ has reached its usage limit — too many requests in a short time, or today’s quota is used up. Switch to another model or AI provider in Settings › AI, or wait a few minutes and try again." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah mencapai batas pemakaian — terlalu banyak permintaan dalam waktu singkat, atau kuota hari ini sudah habis. Ganti ke model atau penyedia AI lain di Pengaturan › AI, atau tunggu beberapa menit lalu coba lagi."
          }
        }
      }
    },
    "%@ has reached its usage limit, so Apple Intelligence was used instead. To keep using %@, switch to another model in Settings › AI or wait a few minutes." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah mencapai batas pemakaian, jadi Apple Intelligence dipakai sebagai gantinya. Untuk tetap memakai %@, ganti ke model lain di Pengaturan › AI atau tunggu beberapa menit."
          }
        }
      }
    },
    "%@ is overloaded for this model right now. Try again in a few minutes." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sedang sibuk untuk model ini. Coba lagi beberapa menit lagi."
          }
        }
      }
    },
    "%@ rejected the API key. Check it in Settings › AI." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menolak kunci API. Periksa di Pengaturan › AI."
          }
        }
      }
    },
    "%@ stopped (%d). %@" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berhenti (%d). %@"
