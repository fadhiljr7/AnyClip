    "Add to Saved (⌘D)" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan (⌘D)"
          }
        }
      }
    },
    "Adds 1–3 animated keyword cards to each clip. You can edit or remove them in the editor." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan 1–3 kartu kata kunci beranimasi ke setiap klip. Anda bisa mengedit atau menghapusnya di editor."
          }
        }
      }
    },
    "Adjust Framing" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur Bingkai"
          }
        }
      }
    },
    "Adjust Framing…" : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
