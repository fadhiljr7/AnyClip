    "Both speakers appear to be on screen in %lld%% of this clip. When only one is visible, the layout switches to full frame." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua pembicara tampaknya terlihat di %lld%% klip ini. Saat hanya satu yang terlihat, tata letak beralih ke satu layar penuh."
          }
        }
      }
    },
    "Both speakers appear to be on screen throughout this clip." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua pembicara tampaknya terlihat di sepanjang klip ini."
