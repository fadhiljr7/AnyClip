    "This video doesn’t have a YouTube transcript." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video ini tidak punya transkrip YouTube."
          }
        }
      }
    },
    "This video has %lld transcripts. Choose the language that’s spoken in the video — the others are usually translations, so captions wouldn’t match what’s said." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
